# Local Wrangler / CF maintainer values (never commit real tokens)
# Copy to .dev.vars only if needed for `wrangler dev`.
# Production deploy uses GitHub Actions secrets — not this file.

# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional overrides (also settable in wrangler.toml [vars])
