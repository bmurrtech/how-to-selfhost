# PM workspace (never delete the directory; keep it out of VCS and build contexts)
/pm/
/pm/*
/tests/
/tests/*
/tmpdata/
/debug/
logs/
**/*.log

# Agent Skills, Settings, Rules, and Data
.cursor/
.agents/

# Graft code graph (local; regenerated via `graft init` / `graft update`)
/graft/

# Secrets and local env (keep env.example / env.local.example tracked)
.env
.env.*
!.env.example
!.env.local.example
# Local AI GPU-host secrets (explicit; also covered by .env above)
scripts/local-ai/.env
# Compose-resolved runtime (generated by resolve_serve; never commit)
scripts/local-ai/**/.runtime.env
scripts/local-ai/**/.runtime.env.*

# Bootstrap / Wrangler (Cloudflare)
bootstrap/.dev.vars
bootstrap/.wrangler/
bootstrap/node_modules/

# Packaging outputs (tarballs + checksums)
/dist/
**/dist/packaging/

# Rust
/target/

# Node / TypeScript
node_modules/
dist/
build/
.next/
coverage/
.turbo/
.vite/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
*.egg-info/
*.egg

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Pre-commit / prek cache (local dev)
.pre-commit-cache/
~/.cache/prek/

# Build and caches (general)
*.log
*.tmp
.cache/
