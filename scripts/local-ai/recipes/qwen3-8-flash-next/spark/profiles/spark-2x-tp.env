# spark-2x-tp — starting TP2 preset (NOT the default 2× topology)
# Prefer spark-2x-replica (2× independent TP1) unless you need >64K / more KV
# on one request. Multi-node wiring is operator-owned; this file documents knobs.
#
# Start here, then measure:
#   64K/seq4 → 96K/seq2 → 128K/seq2 → 192K/seq1 → 262K/seq1

CTX=65536
SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEM=0.75
PREFIX_CACHE=1
MTP=0
TENSOR_PARALLEL_SIZE=2
PLE_MMAP=1
CLIENT_CONTEXT=65536
CLIENT_OUTPUT=16384
