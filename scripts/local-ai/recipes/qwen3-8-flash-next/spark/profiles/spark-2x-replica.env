# spark-2x-replica — default 2× topology
# Run the 1× production recipe (../config/serve.env) independently on each Spark.
# Put LiteLLM / nginx / similar in front. No TP fabric.
#
# Per node (identical to spark-1x):
#   CTX=65536 SEQS=2 MAX_NUM_BATCHED_TOKENS=8192 GPU_MEM=0.75
#   PREFIX_CACHE=1 PLE mmap MTP=0 TP=1
# Aggregate: 2 independent 64K engines, 4 normal active sequences.

CLIENT_CONTEXT=65536
CLIENT_OUTPUT=16384
