# Validated production defaults (1× DGX Spark / GB10, PLE mmap)
# Measured green at 64K (boot + long I/O shapes + prefix-cache). See README.md.
# Community-style names. Override via scripts/local-ai/.env or shell exports.
# Precedence: this file < .env < shell.
#
# Server capacity (hardware/runtime) — these ship as recipe defaults:
#   CTX / --max-model-len     = combined input+output ceiling per request
#   SEQS / --max-num-seqs     = concurrent sequences
#   MAX_NUM_BATCHED_TOKENS    = scheduler batch size (NOT a generation limit)
#   GPU_MEM                   = leave unified-memory / page-cache headroom for mmap
#   PREFIX_CACHE              = 1 after measured repeated-prefix win
#
# Client / IDE policy (advertise separately — do NOT treat as HW limits):
#   CLIENT_CONTEXT=65536      # Kilo/OpenCode limit.context
#   CLIENT_OUTPUT=16384       # tested with reasoningEffort=low; never leave unset (32K fallback)
# Full client guide: docs/client-side-config.md

MODEL=nvidia/Qwen3.8-Flash-Next-NVFP4
IMAGE=qwen38-flash-dgx:c578815
NAME=qwen38-nvfp4
PORT=8000
CTX=65536
SEQS=2
GPU_MEM=0.75
MTP=0
PREFIX_CACHE=1
YARN=0
KV_DTYPE=auto
DET_TOPK=1
EXACT_TOPK=0
PAD_M4=0
DRAFT_VOCAB=1
MADVISE=random
PREWARM=0
WORKERS=32
MAX_NUM_BATCHED_TOKENS=8192
SHM_SIZE=16g
MODE=nvfp4

# IDE advertising presets (documentation only; not consumed by compose)
CLIENT_CONTEXT=65536
CLIENT_OUTPUT=16384

FLASH_REPO_REF=c57881509af3dad83a28e59662fe3c4d29381628
FLASH_REPO_URL=https://github.com/blazux/qwen3.8-Flash-DGX.git
VLLM_IMAGE=vllm/vllm-openai:qwen38-flash-next
