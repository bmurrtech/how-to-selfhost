# 4x RTX PRO 6000 — GPU-resident PLE; high-throughput defaults
PROFILE_ID=gpu-4
PROFILE_STATUS=validated
PLE_MODE=gpu
VLLM_PLE_CPU_OFFLOAD=0
TENSOR_PARALLEL_SIZE=4
CTX=auto
SEQS=256
GPU_MEM=0.95
MAX_NUM_BATCHED_TOKENS=8192
ENABLE_PREFIX_CACHING=1
MOE_BACKEND=marlin
NO_FLASHINFER_AUTOTUNE=1
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
