# 1x RTX PRO 6000 — conservative first-boot (PLE host RAM intent)
# Push-limit knobs (CTX=auto, SEQS=256, batched=8192, prefix on) are for later
# dial-up after a healthy bring-up — override via env / just config.
#
# NOTE: VLLM_PLE_CPU_OFFLOAD=1 is the specialized Qwen3.8 path on
# vllm/vllm-openai:qwen38-flash-next. Generic --cpu-offload-gb is NOT a
# substitute. Wrong image (:latest) can still BF16-OOM ~95GiB on PLE create.
PROFILE_ID=gpu-1
PROFILE_STATUS=validated-intent
PLE_MODE=cpu
VLLM_PLE_CPU_OFFLOAD=1
TENSOR_PARALLEL_SIZE=1
CTX=16384
SEQS=2
GPU_MEM=0.90
MAX_NUM_BATCHED_TOKENS=4096
ENABLE_PREFIX_CACHING=0
MOE_BACKEND=marlin
NO_FLASHINFER_AUTOTUNE=1
ENABLE_AUTO_TOOL_CHOICE=1
TOOL_CALL_PARSER=qwen3_coder
