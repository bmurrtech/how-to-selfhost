# 1× DGX Spark / GB10 — dense NVFP4 serve (no PLE mmap)
# Override via scripts/local-ai/.env or shell exports. Precedence: this file < .env < shell.

MODEL=orcarouter/Qwen3.8-27B-Uncensored-NVFP4
# Serve image (GB10 NVFP4 + MTP). Download image must expose `hf` CLI — keep separate.
IMAGE=ghcr.io/styles01/qwen38-mtp3:latest
VLLM_IMAGE=vllm/vllm-openai:v0.27.1
NAME=qwen38-27b-uncensored-nvfp4
SERVED_MODEL_NAME=Qwen3.8-27B-Uncensored
PORT=8000
COMPOSE_PROJECT_NAME=orcarouter-qwen38-27b-spark

CTX=262144
SEQS=4
GPU_MEM=0.75
MTP=2
PREFIX_CACHE=1
MAX_NUM_BATCHED_TOKENS=8192
SHM_SIZE=16g

# quantization_config is read from config.json — do not pass --quantization
# Omit --kv-cache-dtype unless PASS_KV_DTYPE=1 (then fp8)
PASS_KV_DTYPE=0
KV_DTYPE=

# GB10 / FlashInfer hints (also written to .runtime.env by resolve_dense_serve.sh)
# FLASHINFER_CUDA_ARCH_LIST=12.1a
# FLASHINFER_DISABLE_VERSION_CHECK=1
# VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
# TORCH_CUDA_ARCH_LIST=12.1a
